     1608: // Generate a unique tag ID in format: tag_{timestamp}_{random9}
     1609: fn generate_tag_id() -> String {
     1610:     use std::time::{SystemTime, UNIX_EPOCH};
     1611:     let timestamp = SystemTime::now()
     1612:         .duration_since(UNIX_EPOCH)
     1613:         .unwrap()
     1614:         .as_millis();
     1615:     let uuid = uuid::Uuid::new_v4().to_string();
     1616:     let random = &uuid[0..9]; // First 9 chars of UUID
     1617:     format!("tag_{}_{}", timestamp, random)
     1618: }

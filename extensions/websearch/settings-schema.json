{
  "labels": {
    "prefs": {
      "defaultEngine": "Default search engine",
      "enableSuggestions": "Enable search suggestions",
      "enableAutoDiscovery": "Auto-discover search engines"
    }
  },
  "prefs": {
    "type": "object",
    "properties": {
      "defaultEngine": {
        "type": "string",
        "description": "Choose which search engine to use by default",
        "default": "duckduckgo",
        "enum": ["google", "duckduckgo", "bing", "wikipedia", "kagi"],
        "enumLabels": {
          "google": "Google",
          "duckduckgo": "DuckDuckGo",
          "bing": "Bing",
          "wikipedia": "Wikipedia",
          "kagi": "Kagi"
        }
      },
      "enableSuggestions": {
        "type": "boolean",
        "description": "Enable search suggestions from search engines",
        "default": true
      },
      "enableAutoDiscovery": {
        "type": "boolean",
        "description": "Auto-discover search engines from visited websites via OpenSearch",
        "default": true
      }
    }
  },
  "storageKeys": {
    "PREFS": "prefs",
    "ENGINES": "engines"
  },
  "defaults": {
    "prefs": {
      "defaultEngine": "duckduckgo",
      "enableSuggestions": true,
      "enableAutoDiscovery": true
    }
  }
}

{
  "id": "widget-demo",
  "shortname": "widget-demo",
  "name": "Widget Demo",
  "description": "Demonstration extension showcasing widget sheet capabilities",
  "version": "1.0.0",
  "background": false,
  "builtin": true,
  "commands": [
    {
      "name": "widget demo",
      "description": "Open the widget demo sheet",
      "action": {
        "type": "window",
        "url": "peek://ext/widget-demo/sheet.html",
        "options": { "key": "peek://ext/widget-demo/sheet.html", "trackingSource": "widget-demo" }
      }
    },
    {
      "name": "demo widgets",
      "description": "Open the widget demo sheet (alias)",
      "action": {
        "type": "window",
        "url": "peek://ext/widget-demo/sheet.html",
        "options": { "key": "peek://ext/widget-demo/sheet.html", "trackingSource": "widget-demo" }
      }
    }
  ]
}

{
  "labels": {
    "prefs": {
      "vimMode": "Vim mode",
      "vimSettings": "Vim settings (managed via :set commands)"
    }
  },
  "prefs": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "peek.editor.prefs.schema.json",
    "title": "Editor preferences",
    "description": "Peek app Editor user preferences",
    "type": "object",
    "properties": {
      "vimMode": {
        "description": "Enable vim keybindings in the text editor",
        "type": "boolean",
        "default": false
      },
      "vimSettings": {
        "description": "Persisted vim :set options (wrap, lineNumbers). Managed automatically via vim :set commands.",
        "type": "object",
        "properties": {
          "wrap": {
            "description": "Line wrapping (:set wrap / :set nowrap)",
            "type": "boolean",
            "default": false
          },
          "lineNumbers": {
            "description": "Line numbers and fold gutter (:set number / :set nonumber)",
            "type": "boolean",
            "default": true
          }
        },
        "default": {
          "wrap": false,
          "lineNumbers": true
        }
      }
    }
  },
  "storageKeys": {
    "PREFS": "prefs"
  },
  "defaults": {
    "prefs": {
      "vimMode": false,
      "vimSettings": {
        "wrap": false,
        "lineNumbers": true
      }
    }
  }
}

{
  "manifestVersion": 2,
  "id": "widget-demo",
  "shortname": "widget-demo",
  "name": "Widget Demo",
  "description": "Demonstration extension showcasing widget sheet capabilities",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "type": "background",
      "url": "background.html"
    },
    {
      "id": "sheet",
      "type": "window",
      "url": "sheet.html",
      "windowHints": {
        "key": "peek://ext/widget-demo/sheet.html",
        "title": "Widget Demo"
      }
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "app:shutdown",
        "ext:widget-demo:shutdown",
        "cmd:register",
        "cmd:execute:*"
      ]
    },
    "window": {
      "create": true
    },
    "commands": true,
    "settings": true
  },
  "commands": [
    {
      "name": "widget demo",
      "description": "Open the widget demo sheet",
      "action": {
        "type": "window",
        "url": "peek://ext/widget-demo/sheet.html",
        "options": { "key": "peek://ext/widget-demo/sheet.html", "trackingSource": "widget-demo" }
      }
    },
    {
      "name": "demo widgets",
      "description": "Open the widget demo sheet (alias)",
      "action": {
        "type": "window",
        "url": "peek://ext/widget-demo/sheet.html",
        "options": { "key": "peek://ext/widget-demo/sheet.html", "trackingSource": "widget-demo" }
      }
    }
  ]
}

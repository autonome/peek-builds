{
  "manifestVersion": 2,
  "id": "features-manager",
  "shortname": "features-manager",
  "name": "Features Manager",
  "description": "Browse, install, manage, and publish non-built-in tile features",
  "version": "1.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "type": "background",
      "url": "background.html",
      "lazy": true
    },
    {
      "id": "manage",
      "type": "window",
      "url": "manage.html",
      "windowHints": {
        "role": "workspace",
        "key": "features-manage",
        "width": 900,
        "height": 650,
        "title": "Features"
      }
    },
    {
      "id": "browse",
      "type": "window",
      "url": "browse.html",
      "windowHints": {
        "role": "workspace",
        "key": "features-browse",
        "width": 960,
        "height": 720,
        "title": "Browse Features"
      }
    },
    {
      "id": "publish",
      "type": "window",
      "url": "publish.html",
      "windowHints": {
        "role": "workspace",
        "key": "features-publish",
        "width": 700,
        "height": 600,
        "title": "Publish Feature"
      }
    }
  ],
  "capabilities": {
    "features": {
      "read": true,
      "install": true,
      "manage": true,
      "update": true,
      "dev": true,
      "publish": true,
      "devtools": true,
      "browse": true,
      "sources": ["builtin", "local", "atproto", "url", "dev"]
    },
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "feature:*",
        "ext:ready",
        "app:shutdown",
        "lex:session-changed"
      ]
    },
    "datastore": {
      "tables": ["features_history"]
    },
    "network": {
      "domains": [
        "*.bsky.network",
        "*.bsky.social",
        "bsky.social",
        "public.api.bsky.app",
        "plc.directory",
        "*.host.bsky.network"
      ]
    },
    "window": {
      "create": true,
      "query": true
    },
    "commands": true,
    "shortcuts": true,
    "settings": { "readForeign": ["lex"] }
  },
  "commands": [
    {
      "name": "features",
      "description": "Open features manager",
      "action": {
        "type": "window",
        "url": "peek://ext/features-manager/manage.html",
        "options": {
          "role": "workspace",
          "key": "features-manage",
          "width": 900,
          "height": 650,
          "title": "Features"
        }
      }
    },
    {
      "name": "manage features",
      "description": "Open features manager",
      "action": {
        "type": "window",
        "url": "peek://ext/features-manager/manage.html",
        "options": {
          "role": "workspace",
          "key": "features-manage",
          "width": 900,
          "height": 650,
          "title": "Features"
        }
      }
    },
    {
      "name": "browse features",
      "description": "Browse and search features by publisher",
      "action": {
        "type": "window",
        "url": "peek://ext/features-manager/browse.html",
        "options": {
          "role": "workspace",
          "key": "features-browse",
          "width": 960,
          "height": 720,
          "title": "Browse Features"
        }
      }
    },
    {
      "name": "publish feature",
      "description": "Publish a local feature to AT Protocol",
      "action": {
        "type": "window",
        "url": "peek://ext/features-manager/publish.html",
        "options": {
          "role": "workspace",
          "key": "features-publish",
          "width": 700,
          "height": 600,
          "title": "Publish Feature",
          "webPreferences": { "webSecurity": false }
        }
      }
    },
    {
      "name": "list features",
      "description": "List installed features",
      "action": { "type": "execute" }
    },
    {
      "name": "check feature updates",
      "description": "Check all installed features for available updates",
      "action": { "type": "execute" }
    },
    {
      "name": "update feature",
      "description": "Update a specific feature to the latest version",
      "action": { "type": "execute" }
    }
  ],
  "shortcuts": [
    {
      "keys": "CommandOrControl+Shift+X",
      "command": "features"
    }
  ],
  "settingsSchema": "settings-schema.json"
}

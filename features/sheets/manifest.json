{
  "manifestVersion": 2,
  "id": "sheets",
  "shortname": "sheets",
  "name": "Sheets",
  "description": "Widget sheets with freeform card layouts hosting webviews",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "type": "background",
      "url": "background.html",
      "lazy": true
    },
    {
      "id": "sheet",
      "type": "window",
      "url": "sheet.html",
      "windowHints": {
        "title": "Sheet"
      }
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["system"],
      "topics": [
        "ext:ready",
        "ext:sheets:shutdown",
        "app:shutdown"
      ]
    },
    "window": {
      "create": true
    },
    "commands": true,
    "settings": true
  },
  "commands": [
    {
      "name": "sheets",
      "description": "List all widget sheets",
      "action": { "type": "execute" }
    },
    {
      "name": "new sheet",
      "description": "Create a new widget sheet",
      "action": { "type": "execute" }
    },
    {
      "name": "open sheet",
      "description": "Open an existing widget sheet by name",
      "action": { "type": "execute" }
    }
  ]
}

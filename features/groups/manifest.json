{
  "manifestVersion": 2,
  "id": "groups",
  "shortname": "groups",
  "name": "Groups",
  "description": "Tag-based grouping of addresses",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "type": "background",
      "url": "background.html",
      "lazy": true
    },
    {
      "id": "home",
      "type": "window",
      "url": "home.html",
      "windowHints": {
        "role": "workspace",
        "key": "peek://ext/groups/home.html",
        "width": 800,
        "height": 600,
        "title": "Groups"
      }
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "tag:*",
        "item:*",
        "group:*",
        "groups:*",
        "cmd:*",
        "window:*",
        "sync:pull-completed",
        "ext:ready",
        "ext:groups:shutdown",
        "app:shutdown"
      ]
    },
    "datastore": {
      "tables": ["items", "tags", "item_tags", "item_events"]
    },
    "window": {
      "create": true,
      "query": true,
      "manage": true
    },
    "context": {
      "read": ["mode"],
      "write": ["mode"],
      "modes": true,
      "queryWindows": true
    },
    "commands": true,
    "shortcuts": true,
    "settings": true
  },
  "commands": [
    {
      "name": "groups",
      "description": "Saved tab groups",
      "action": { "type": "execute" }
    },
    {
      "name": "open groups",
      "description": "Open groups browser",
      "action": {
        "type": "window",
        "url": "peek://ext/groups/home.html",
        "options": { "role": "workspace", "width": 1024, "height": 768 }
      }
    },
    {
      "name": "close group",
      "description": "Hide all windows in the current group (restore later)",
      "action": { "type": "execute" }
    },
    {
      "name": "switch group",
      "description": "Close current group and open another",
      "action": { "type": "execute" }
    },
    {
      "name": "restore group",
      "description": "Restore a previously closed (suspended) group",
      "action": { "type": "execute" }
    },
    {
      "name": "pin",
      "description": "Pin a URL in the current group (always opens with group)",
      "action": { "type": "execute" }
    },
    {
      "name": "unpin",
      "description": "Unpin a URL from the current group",
      "action": { "type": "execute" }
    }
  ],
  "shortcuts": [
    {
      "keys": "CommandOrControl+G",
      "command": "groups"
    }
  ],
  "settingsSchema": "./settings-schema.json"
}

{
  "manifestVersion": 3,
  "id": "hello-world",
  "shortname": "hello-world",
  "name": "Hello World",
  "description": "Tutorial and diagnostic tile for tile authors",
  "version": "1.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "home",
      "url": "home.html",
      "width": 700,
      "height": 900,
      "title": "Hello World",
      "resident": true
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": ["hello:ping", "item:created", "item:deleted"]
    },
    "datastore": {
      "tables": ["items"]
    },
    "commands": true
  },
  "commands": [
    {
      "name": "hello world",
      "description": "Open Hello World tile (tutorial + debug)",
      "action": { "type": "execute" }
    }
  ]
}

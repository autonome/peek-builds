{
  "manifestVersion": 2,
  "id": "websearch",
  "shortname": "websearch",
  "name": "Web Search",
  "description": "Search the web from the command palette with engine discovery and suggestions",
  "version": "2.0.0",
  "builtin": true,
  "settingsSchema": "./settings-schema.json",
  "tiles": [
    {
      "id": "home",
      "url": "home.html",
      "width": 600,
      "height": 500,
      "title": "Web Search",
      "role": "workspace",
      "key": "websearch-home",
      "resident": true
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "ext:websearch:shutdown",
        "app:shutdown",
        "page:loaded",
        "window:closed",
        "websearch:*",
        "cmd:execute:*"
      ]
    },
    "network": {
      "domains": ["*"]
    },
    "window": {
      "create": true,
      "query": true
    },
    "commands": true,
    "settings": true
  },
  "commands": [
    {
      "name": "web search",
      "description": "Search the web with your default search engine",
      "action": { "type": "execute" },
      "params": [{ "name": "query", "type": "string", "required": false, "description": "Search query" }]
    },
    {
      "name": "open web search",
      "description": "Open the web search window",
      "action": { "type": "execute" }
    },
    {
      "name": "kagi",
      "description": "Search Kagi",
      "action": { "type": "execute" },
      "params": [{ "name": "query", "type": "string", "required": false, "description": "Search query" }]
    },
    {
      "name": "google",
      "description": "Search Google",
      "action": { "type": "execute" },
      "params": [{ "name": "query", "type": "string", "required": false, "description": "Search query" }]
    },
    {
      "name": "ddg",
      "description": "Search DuckDuckGo",
      "action": { "type": "execute" },
      "params": [{ "name": "query", "type": "string", "required": false, "description": "Search query" }]
    },
    {
      "name": "bing",
      "description": "Search Bing",
      "action": { "type": "execute" },
      "params": [{ "name": "query", "type": "string", "required": false, "description": "Search query" }]
    },
    {
      "name": "wiki",
      "description": "Search Wikipedia",
      "action": { "type": "execute" },
      "params": [{ "name": "query", "type": "string", "required": false, "description": "Search query" }]
    }
  ]
}

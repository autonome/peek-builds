{
  "manifestVersion": 3,
  "id": "editor",
  "shortname": "editor",
  "name": "Editor",
  "description": "Markdown editor with outline sidebar, live preview, and vim mode",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true,
      "lazyEvents": ["editor:open", "editor:add"]
    },
    {
      "id": "home",
      "url": "home.html",
      "role": "workspace",
      "width": 1024,
      "height": 1000,
      "title": "Editor"
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "editor:*",
        "item:*",
        "tag:*",
        "window:*",
        "app:focus-changed",
        "app:shutdown",
        "cmd:*",
        "sync:pull-completed",
        "ext:ready",
        "ext:editor:shutdown"
      ]
    },
    "datastore": {
      "tables": ["items", "item_events", "tags", "item_tags"]
    },
    "window": {
      "create": true,
      "query": true,
      "manage": true
    },
    "context": {
      "read": ["mode"],
      "write": ["mode"],
      "modes": true
    },
    "filesystem": {
      "read": ["*"],
      "write": ["*"]
    },
    "dialogs": true,
    "commands": true,
    "shortcuts": true,
    "settings": true
  },
  "commands": [
    {
      "name": "editor",
      "description": "Open markdown editor",
      "action": { "type": "execute" }
    }
  ],
  "shortcuts": [
    {
      "keys": "CommandOrControl+E",
      "command": "editor"
    }
  ],
  "settingsSchema": "./settings-schema.json",
  "_notes": {
    "lazyEventInterceptors": "The background tile declares `lazyEvents: ['editor:open', 'editor:add']` so tile-lazy.ts registers pubsub stubs that load the tile on first event publish. This replaces the v1 main.ts registerLazyEventInterceptors() path for editor — v2 features declare their lazy-triggering events directly in their manifest and the runtime wires the interceptor stubs via tile-lazy.ts."
  }
}

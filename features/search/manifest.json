{
  "manifestVersion": 2,
  "id": "search",
  "shortname": "search",
  "name": "Search",
  "description": "Search across items by text and tags",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "type": "background",
      "url": "background.html",
      "lazy": true
    },
    {
      "id": "home",
      "type": "window",
      "url": "home.html",
      "windowHints": {
        "role": "workspace",
        "key": "search-home",
        "width": 700,
        "height": 768,
        "title": "Search"
      }
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "ext:search:shutdown",
        "app:shutdown",
        "cmd:execute:search",
        "sync:pull-completed",
        "item:created",
        "item:deleted",
        "tag:item-added",
        "tag:item-removed",
        "editor:open"
      ]
    },
    "datastore": {
      "tables": ["items", "tags", "item_tags"]
    },
    "window": {
      "create": true
    },
    "commands": true
  },
  "commands": [
    {
      "name": "search",
      "description": "Search items by text and tags",
      "action": { "type": "execute" }
    }
  ]
}

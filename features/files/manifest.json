{
  "manifestVersion": 2,
  "id": "files",
  "name": "Files",
  "description": "File and format commands (CSV, save)",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "type": "background",
      "url": "background.html",
      "lazy": true
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "ext:files:shutdown",
        "app:shutdown",
        "editor:changed"
      ]
    },
    "datastore": {
      "tables": ["items", "tags", "item_tags"]
    },
    "filesystem": {
      "read": ["*"],
      "write": ["*"]
    },
    "dialogs": { "types": ["save", "open"] },
    "commands": true
  },
  "commands": [
    {
      "name": "open file",
      "description": "Open a file from disk (native file picker)",
      "action": { "type": "execute" }
    },
    {
      "name": "csv",
      "description": "Convert JSON to CSV format",
      "accepts": ["application/json"],
      "produces": ["text/csv"],
      "action": { "type": "execute" }
    },
    {
      "name": "save",
      "description": "Save data to a file (save dialog)",
      "accepts": ["*/*"],
      "produces": [],
      "action": { "type": "execute" }
    },
    {
      "name": "markdown",
      "description": "Format items as a markdown document",
      "accepts": ["application/json"],
      "produces": ["text/markdown"],
      "action": { "type": "execute" }
    },
    {
      "name": "save as note",
      "description": "Save text content as a new note in the datastore",
      "accepts": ["text/plain", "text/markdown", "text/html"],
      "produces": [],
      "action": { "type": "execute" }
    }
  ]
}

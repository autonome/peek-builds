{
  "manifestVersion": 3,
  "id": "entities",
  "shortname": "entities",
  "name": "Entity Recognition",
  "description": "Automatically extracts and indexes entities (people, places, orgs, events) from visited pages",
  "version": "3.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true,
      "lazyEvents": [
        "scripts:execute:entities-extract",
        "entities:extract",
        "entities:search",
        "entities:get-for-url"
      ]
    },
    {
      "id": "home",
      "url": "home.html",
      "width": 900,
      "height": 700,
      "title": "Entities",
      "role": "workspace",
      "key": "entities-browser",
      "lazy": true
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "ext:entities:shutdown",
        "app:shutdown",
        "item:created",
        "item:deleted",
        "page:content-ready",
        "editor:changed",
        "sync:pull-completed",
        "scripts:execute:entities-extract",
        "entities:extract",
        "entities:extract:response",
        "entities:extracted",
        "entities:search",
        "entities:search:response",
        "entities:get-for-url",
        "entities:get-for-url:response"
      ]
    },
    "datastore": {
      "tables": ["items", "item_events", "item_tags", "tags"]
    },
    "network": {
      "domains": ["*"]
    },
    "window": {
      "create": true,
      "query": true
    },
    "context": {
      "read": ["entities"],
      "write": ["entities"]
    },
    "commands": true,
    "rules": true
  },
  "commands": [
    {
      "name": "extract entities",
      "description": "Extract entities from current page",
      "action": { "type": "execute" }
    }
  ],
  "rules": [
    {
      "topic": "page:content-ready",
      "scriptId": "entities-extract",
      "match": { "url": { "$startsWith": "http" } }
    },
    {
      "topic": "item:created",
      "scriptId": "entities-extract",
      "match": { "itemType": "url" }
    }
  ]
}

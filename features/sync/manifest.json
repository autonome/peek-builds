{
  "manifestVersion": 3,
  "id": "sync",
  "name": "Sync",
  "version": "2.0.0",
  "description": "Sync commands and functionality",
  "builtin": true,
  "hidden": true,
  "background": false,
  "tiles": [],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "sync:*",
        "ext:ready",
        "ext:sync:shutdown",
        "app:shutdown"
      ]
    },
    "commands": true,
    "sync": true
  },
  "commands": [
    {
      "name": "Sync now",
      "description": "Trigger manual sync with server",
      "action": { "type": "publish", "topic": "sync:manual-trigger" }
    }
  ]
}

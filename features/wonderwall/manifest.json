{
  "manifestVersion": 3,
  "id": "wonderwall",
  "shortname": "wonderwall",
  "name": "Wonderwall",
  "description": "OAuth account manager for connected services",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true
    },
    {
      "id": "home",
      "url": "home.html",
      "role": "workspace",
      "key": "wonderwall-home",
      "width": 1024,
      "height": 768,
      "title": "Wonderwall"
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "ext:wonderwall:shutdown",
        "app:shutdown"
      ]
    },
    "network": {
      "domains": [
        "accounts.google.com",
        "oauth2.googleapis.com",
        "www.googleapis.com",
        "soundcloud.com",
        "api.soundcloud.com",
        "secure.soundcloud.com",
        "www.reddit.com",
        "oauth.reddit.com"
      ]
    },
    "window": {
      "create": true
    },
    "commands": true,
    "settings": true
  },
  "commands": [
    {
      "name": "accounts",
      "description": "Open the connected accounts manager",
      "action": {
        "type": "window",
        "url": "peek://wonderwall/home.html",
        "options": {
          "role": "workspace",
          "key": "wonderwall-home",
          "width": 1024,
          "height": 768,
          "title": "Wonderwall"
        }
      }
    }
  ]
}

{
  "manifestVersion": 2,
  "id": "wonderwall",
  "shortname": "wonderwall",
  "name": "Wonderwall",
  "description": "OAuth account manager for connected services",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "type": "background",
      "url": "background.html",
      "lazy": true
    },
    {
      "id": "home",
      "type": "window",
      "url": "home.html",
      "windowHints": {
        "role": "workspace",
        "key": "wonderwall-home",
        "width": 1024,
        "height": 768,
        "title": "Wonderwall"
      }
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "ext:wonderwall:shutdown",
        "app:shutdown"
      ]
    },
    "network": {
      "domains": ["*"]
    },
    "window": {
      "create": true
    },
    "commands": true
  },
  "commands": [
    {
      "name": "accounts",
      "description": "Open the connected accounts manager",
      "action": {
        "type": "window",
        "url": "peek://ext/wonderwall/home.html",
        "options": {
          "role": "workspace",
          "key": "wonderwall-home",
          "width": 1024,
          "height": 768,
          "title": "Wonderwall"
        }
      }
    }
  ]
}

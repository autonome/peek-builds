{
  "manifestVersion": 2,
  "id": "lex",
  "shortname": "lex",
  "name": "Lexicon Studio",
  "description": "Your AT Protocol identity and data",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "type": "background",
      "url": "background.html",
      "lazy": true
    },
    {
      "id": "home",
      "type": "window",
      "url": "home.html",
      "windowHints": {
        "role": "workspace",
        "key": "lex-home",
        "width": 860,
        "height": 620,
        "title": "Lexicon Studio"
      }
    },
    {
      "id": "chain-form",
      "type": "window",
      "url": "chain-form.html",
      "windowHints": {
        "role": "panel",
        "width": 520,
        "height": 560,
        "title": "New Record"
      }
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "ext:lex:shutdown",
        "app:shutdown",
        "lex:session-changed",
        "lex:recent-lexicons-changed",
        "lex:open-create",
        "chain-popup:content",
        "chain-popup:result"
      ]
    },
    "network": {
      "domains": ["*"]
    },
    "window": {
      "create": true,
      "query": true,
      "close": true
    },
    "commands": true,
    "settings": true
  },
  "commands": [
    {
      "name": "lexicon studio",
      "description": "Open AT Protocol identity panel",
      "action": {
        "type": "window",
        "url": "peek://lex/home.html",
        "options": {
          "role": "workspace",
          "key": "lex-home",
          "width": 860,
          "height": 620,
          "title": "Lexicon Studio",
          "webPreferences": { "webSecurity": false }
        }
      }
    },
    {
      "name": "lex",
      "description": "Browse lexicons",
      "action": { "type": "execute" }
    }
  ]
}

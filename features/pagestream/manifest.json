{
  "manifestVersion": 3,
  "id": "pagestream",
  "shortname": "pagestream",
  "name": "Pagestream",
  "description": "Vertical, chat-like navigational interface for web history",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true
    },
    {
      "id": "home",
      "url": "home.html",
      "role": "workspace",
      "key": "peek://pagestream/home.html",
      "transparent": true,
      "title": "Pagestream"
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "ext:pagestream:shutdown",
        "app:shutdown",
        "window:closed",
        "pagestream:settings-changed",
        "pagestream:settings-update",
        "pagestream:nav",
        "page:navigate",
        "item:created",
        "item:deleted",
        "tag:item-added",
        "tag:item-removed",
        "sync:pull-completed",
        "affordance:click",
        "rules:changed"
      ]
    },
    "datastore": {
      "tables": ["items", "tags", "item_tags", "item_visits"]
    },
    "window": {
      "create": true,
      "query": true,
      "manage": true
    },
    "commands": true,
    "shortcuts": true,
    "settings": true,
    "rules": true
  },
  "commands": [
    {
      "name": "pagestream",
      "description": "Open browsing history stream",
      "action": { "type": "execute" }
    }
  ],
  "shortcuts": [
    {
      "keys": "CommandOrControl+Shift+P",
      "command": "pagestream"
    }
  ]
}

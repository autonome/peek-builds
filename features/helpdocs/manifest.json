{
  "manifestVersion": 2,
  "id": "helpdocs",
  "shortname": "helpdocs",
  "name": "Help docs",
  "description": "Helpful documentation and assistance features",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "type": "background",
      "url": "background.html",
      "lazy": true
    },
    {
      "id": "overlay",
      "type": "window",
      "url": "overlay.html",
      "windowHints": {
        "transparent": true,
        "alwaysOnTop": true,
        "focusable": false,
        "resizable": false,
        "frame": false,
        "title": "Help Docs"
      }
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global"],
      "topics": [
        "app:focus-changed"
      ]
    },
    "window": {
      "create": true,
      "manage": true,
      "urls": ["peek://helpdocs/overlay.html"]
    },
    "commands": true
  },
  "commands": [
    {
      "name": "help docs",
      "description": "Toggle help documentation overlay",
      "action": { "type": "execute" }
    }
  ]
}

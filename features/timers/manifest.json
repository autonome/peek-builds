{
  "id": "timers",
  "shortname": "timers",
  "name": "Timers",
  "description": "Countdown timers, alarms, stopwatches, and interval timers",
  "version": "1.0.0",
  "background": "background.html",
  "builtin": true,
  "commands": [
    {
      "name": "timers",
      "description": "View all timers",
      "action": { "type": "execute" }
    },
    {
      "name": "timer countdown",
      "description": "Start a countdown timer (e.g., 30m, 1h, 5m30s)",
      "action": { "type": "execute" }
    },
    {
      "name": "timer alarm",
      "description": "Set an alarm for a specific time (e.g., 6pm, 14:30)",
      "action": { "type": "execute" }
    },
    {
      "name": "timer stopwatch",
      "description": "Start a stopwatch that counts up",
      "action": { "type": "execute" }
    },
    {
      "name": "timer interval",
      "description": "Start a repeating interval timer",
      "action": { "type": "execute" }
    }
  ],
  "shortcuts": [
    {
      "keys": "Option+t",
      "command": "timers"
    },
    {
      "keys": "CommandOrControl+T",
      "command": "timers"
    }
  ]
}

{
  "manifestVersion": 2,
  "id": "tags",
  "shortname": "tags",
  "name": "Tags",
  "description": "Tag visualization and management",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "type": "background",
      "url": "background.html",
      "lazy": true
    },
    {
      "id": "home",
      "type": "window",
      "url": "home.html",
      "windowHints": {
        "role": "workspace",
        "key": "tags-home",
        "width": 900,
        "height": 700,
        "title": "Tags"
      }
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "tag:*",
        "item:*",
        "editor:*",
        "cmd:execute:*",
        "sync:pull-completed",
        "entities:extracted",
        "ext:ready",
        "ext:tags:shutdown",
        "app:shutdown"
      ]
    },
    "datastore": {
      "tables": ["items", "tags", "item_tags", "item_events"]
    },
    "window": {
      "create": true,
      "query": true
    },
    "commands": true,
    "shortcuts": true,
    "settings": { "readForeign": ["editor"] }
  },
  "commands": [
    {
      "name": "tag",
      "description": "Add tags to the active window URL",
      "action": { "type": "execute" }
    },
    {
      "name": "tags",
      "description": "Show tags for the active window URL (or all tags by frecency)",
      "action": { "type": "execute" }
    },
    {
      "name": "untag",
      "description": "Remove tags from the active window URL",
      "action": { "type": "execute" }
    },
    {
      "name": "tagset",
      "description": "Create a tagset with specified tags",
      "action": { "type": "execute" }
    },
    {
      "name": "open tags",
      "description": "Open the tags browser",
      "action": {
        "type": "window",
        "url": "peek://ext/tags/home.html",
        "options": { "role": "workspace", "key": "tags-home", "width": 900, "height": 700, "title": "Tags" }
      }
    }
  ],
  "shortcuts": [
    {
      "keys": "Option+t",
      "command": "open tags",
      "global": true
    },
    {
      "keys": "CommandOrControl+T",
      "command": "open tags"
    }
  ]
}

{
  "manifestVersion": 2,
  "id": "slides",
  "shortname": "slides",
  "name": "Slides",
  "description": "Edge-anchored slide-in panels triggered by keyboard shortcuts",
  "version": "2.0.0",
  "builtin": true,
  "settingsSchema": "./settings-schema.json",
  "tiles": [
    {
      "id": "background",
      "type": "background",
      "url": "background.html"
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "slides:*",
        "window:closed",
        "ext:ready",
        "app:shutdown",
        "ext:slides:shutdown"
      ]
    },
    "window": {
      "create": true,
      "query": true,
      "manage": true
    },
    "shortcuts": true,
    "settings": true
  }
}

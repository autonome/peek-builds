{
  "manifestVersion": 3,
  "id": "tag-actions",
  "shortname": "tag-actions",
  "name": "Tag Actions",
  "description": "Define custom actions triggered by tags",
  "version": "3.0.0",
  "builtin": true,
  "settingsSchema": "./settings-schema.json",
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true,
      "lazyEvents": ["scripts:execute:tag-swap"]
    },
    {
      "id": "home",
      "url": "home.html",
      "width": 560,
      "height": 400,
      "title": "Tag Pairs",
      "role": "workspace",
      "key": "tag-actions-home",
      "lazy": true
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "ext:tag-actions:shutdown",
        "app:shutdown",
        "scripts:execute:tag-swap",
        "rules:changed",
        "tag:added",
        "tag:removed"
      ]
    },
    "window": {
      "create": true
    },
    "commands": true,
    "settings": true,
    "rules": true,
    "datastore": { "tables": ["items", "tags", "item_tags"] }
  },
  "commands": [
    {
      "name": "tag actions",
      "description": "Open the tag actions manager",
      "action": { "type": "execute" }
    }
  ],
  "rules": [
    {
      "topic": "affordance:click",
      "scriptId": "tag-swap",
      "match": { "activeTag": "todo", "completedTag": "done" },
      "config": { "activeTag": "todo", "completedTag": "done" },
      "display": {
        "icon": "unchecked",
        "checkedIcon": "checked",
        "color": "#007aff",
        "checkedColor": "#34c759",
        "iconPair": "checkbox"
      }
    },
    {
      "topic": "affordance:click",
      "scriptId": "tag-swap",
      "match": { "activeTag": "readme", "completedTag": "read" },
      "config": { "activeTag": "readme", "completedTag": "read" },
      "display": {
        "icon": "eye-open",
        "checkedIcon": "eye-closed",
        "color": "#007aff",
        "checkedColor": "#34c759",
        "iconPair": "eye"
      }
    }
  ]
}

{
  "manifestVersion": 2,
  "id": "tag-actions",
  "shortname": "tag-actions",
  "name": "Tag Actions",
  "description": "Define custom actions triggered by tags",
  "version": "2.0.0",
  "builtin": true,
  "settingsSchema": "./settings-schema.json",
  "tiles": [
    {
      "id": "home",
      "url": "home.html",
      "width": 560,
      "height": 400,
      "title": "Tag Pairs",
      "role": "workspace",
      "key": "tag-actions-home",
      "resident": true
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "ext:tag-actions:shutdown",
        "app:shutdown",
        "tag-actions:get-all",
        "tag-actions:get-all:response",
        "tag-actions:create",
        "tag-actions:create:response",
        "tag-actions:update",
        "tag-actions:update:response",
        "tag-actions:delete",
        "tag-actions:delete:response"
      ]
    },
    "window": {
      "create": true
    },
    "commands": true,
    "settings": true
  },
  "commands": [
    {
      "name": "tag actions",
      "description": "Open the tag actions manager",
      "action": { "type": "execute" }
    }
  ]
}

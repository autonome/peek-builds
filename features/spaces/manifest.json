{
  "manifestVersion": 2,
  "id": "spaces",
  "shortname": "spaces",
  "name": "Spaces",
  "description": "Workspace mode with auto-tagging, screen border, and session management",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "type": "background",
      "url": "background.html",
      "lazy": true
    },
    {
      "id": "home",
      "type": "window",
      "url": "home.html",
      "windowHints": {
        "role": "workspace",
        "width": 800,
        "height": 600,
        "title": "Spaces"
      }
    },
    {
      "id": "border",
      "type": "window",
      "url": "border.html",
      "windowHints": {
        "role": "overlay",
        "transparent": true,
        "frame": false,
        "focusable": false,
        "alwaysOnTop": true
      }
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "ext:spaces:shutdown",
        "app:shutdown",
        "cmd:execute:*",
        "cmd:register",
        "cmd:unregister",
        "item:created",
        "item:deleted",
        "tag:item-added",
        "tag:item-removed",
        "tag:created",
        "tag:renamed",
        "tag:color-changed",
        "sync:pull-completed",
        "window:focused",
        "window:closed",
        "app:focus-changed",
        "spaces:*"
      ]
    },
    "datastore": {
      "tables": ["tags", "items", "item_tags"]
    },
    "context": {
      "read": ["mode"],
      "write": ["mode"],
      "modes": true,
      "queryWindows": true
    },
    "window": {
      "create": true,
      "query": true,
      "manage": true
    },
    "commands": true,
    "settings": true
  },
  "commands": [
    {
      "name": "open space",
      "description": "Open a space (restore saved state or show home)",
      "action": { "type": "execute" }
    },
    {
      "name": "close space",
      "description": "Save window state and close all space windows",
      "action": { "type": "execute" }
    },
    {
      "name": "switch space",
      "description": "Close current space and open another",
      "action": { "type": "execute" }
    },
    {
      "name": "open spaces",
      "description": "Browse all spaces",
      "action": {
        "type": "window",
        "url": "peek://ext/spaces/home.html",
        "options": {
          "width": 800,
          "height": 600,
          "role": "workspace"
        }
      }
    }
  ]
}

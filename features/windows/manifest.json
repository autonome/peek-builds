{
  "manifestVersion": 3,
  "id": "windows",
  "shortname": "windows",
  "name": "Windows",
  "description": "Full-screen window switcher with transparent overlay",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true
    },
    {
      "id": "windows-overlay",
      "url": "windows.html",
      "role": "overlay",
      "transparent": true,
      "alwaysOnTop": true,
      "resizable": false
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "ext:windows:shutdown",
        "app:shutdown",
        "window:closed"
      ]
    },
    "window": {
      "create": true,
      "query": true,
      "manage": true
    },
    "commands": true,
    "shortcuts": true,
    "settings": true,
    "izui": true
  },
  "commands": [
    {
      "name": "windows",
      "description": "Show all windows in full-screen overlay",
      "action": { "type": "execute" }
    },
    {
      "name": "center window",
      "description": "Center the active window on its display",
      "action": { "type": "execute" }
    },
    {
      "name": "center all windows",
      "description": "Center all windows on their respective displays",
      "action": { "type": "execute" }
    },
    {
      "name": "maximize window",
      "description": "Maximize the active window",
      "action": { "type": "execute" }
    },
    {
      "name": "fullscreen",
      "description": "Toggle fullscreen for the active window",
      "action": { "type": "execute" }
    }
  ],
  "shortcuts": [
    {
      "keys": "CommandOrControl+Shift+W",
      "command": "windows"
    }
  ]
}

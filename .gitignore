# Dependencies (no trailing slash — also match symlinks at these paths)
node_modules

# Yarn
.yarn/install-state.gz
.yarn/releases/

# Build output
out/
app/dist/
dist/
# Patched @tanstack/virtual-core copy (regenerated by scripts/patch-virtual-core.js at build time)
apps/desktop/renderer/lib/virtual-core/

# Tauri build output
apps/tauri-desktop/src-tauri/target/
apps/tauri-desktop/src-tauri/gen/
apps/mobile/src-tauri/target/
apps/mobile/peek-core/target/
apps/mobile/peek-core/generated/
apps/mobile/peek-core/PeekCore.xcframework/

# Server data (local testing)
apps/server/data/

# Environment files (contain secrets)
.env
.env.local
.env.*.local

# Test output
test-results/
playwright-report/

# Claude Code local settings (per-user); skills/, settings.json, hooks/ are shared
.claude/*
!.claude/skills/
!.claude/settings.json
!.claude/hooks/
!.claude/retiring.txt

# Agent task scratch files
.agent-task.md
/CLAUDE.md

# Session handoff notes (per-user session scratch — not source-controlled)
handoff.md

# Isolated agent workspaces (created by scripts/spawn-isolated-agent.sh)
../mpeek-agent-*
# Isolated agent clones (created by scripts/spawn-isolated-clone.sh)
.worktrees/
# Local clone-task metadata (created by spawn-isolated-clone.sh inside a
# clone's own root when /tmp/mpeek-clone-task is set — never tracked)
.clone-task

# Backup files
*.bak
*.swp
Backups/

# Personal notes (not tracked)
TODO-mine.md
*-mine.md

# Xcode app container exports
*.xcappdata/

# Device backups (use ~/sync/peek-backups/ instead)
device-backup-*/

# Chrome extension resources (large binaries).
# Individual extensions are un-ignored below (must re-include parent and all subpaths).
chrome-extensions/*
!chrome-extensions/README.md
# Exceptions: vendored small extensions we want tracked
!chrome-extensions/twp/

# Experimental/unused files
babel.config.json
webpack.config.js
/debug.js
package.js
protocol-imports.diff
test/
!.claude/skills/test/
tmp/

# Per-developer MCP server configs (machine-local absolute paths)
/.mcp.json

# >>> peek-mcp-init (auto-managed) >>>
# Per-developer Peek MCP wiring — machine/scope-specific, do not commit.
.mcp.json
.claude/settings.local.json
.claude/skills/peek.md

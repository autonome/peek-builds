#!/bin/sh
# peek-mcp-init — scaffold a per-project .mcp.json with Peek MCP scope.
#
# Convenience wrapper around `peek-mcp --install --mcp-json --scope <tag>`.
# Run from the project root; writes ./.mcp.json so a Claude Code session
# in this directory can read (and optionally write) only Peek items
# tagged <tag> or <tag>:*.

set -e

if [ "$#" -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  cat <<'EOF'
peek-mcp-init — scaffold a per-project .mcp.json with Peek MCP scope.

Usage:
  peek-mcp-init <tag> [--writes] [--profile <name>] [--force]

Writes ./.mcp.json so a Claude Code session in this directory can read
(and optionally write) only Peek items tagged <tag> or <tag>:*.

Options:
  --writes          Enable mutating tools (default: read-only)
  --profile <name>  Peek profile to expose (default: "default")
  --force           Overwrite an existing peek entry that differs

After running, fully quit and reopen Claude Code in this directory.
Re-approving the /mcp prompt is not enough — the running peek-mcp child
must be respawned to pick up the new env.
EOF
  exit 0
fi

TAG="$1"
shift

RESOURCES_DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$RESOURCES_DIR/peek-mcp" --install --mcp-json --scope "$TAG" "$@"

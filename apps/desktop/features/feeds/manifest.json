{
  "manifestVersion": 3,
  "id": "feeds",
  "shortname": "feeds",
  "name": "Feed Reader",
  "description": "Simple RSS/Atom feed reader demonstrating the series and feeds APIs",
  "version": "2.0.0",
  "builtin": true,
  "settingsSchema": "./settings-schema.json",
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true,
      "schedule": [
        { "topic": "feeds:poll", "everyMinutes": 15 }
      ]
    },
    {
      "id": "feeds-reader",
      "url": "feeds.html",
      "key": "feeds-reader",
      "width": 900,
      "height": 700,
      "title": "Feed Reader"
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "ext:feeds:shutdown",
        "app:shutdown",
        "item:created",
        "feeds:poll"
      ]
    },
    "datastore": {
      "tables": ["items", "item_events"]
    },
    "network": {
      "domains": ["*"]
    },
    "window": {
      "create": true
    },
    "commands": true,
    "shortcuts": true
  },
  "commands": [
    {
      "name": "open feeds",
      "description": "Open the feed reader",
      "action": {
        "type": "window",
        "url": "peek://feeds/feeds.html",
        "options": { "key": "feeds-reader", "width": 900, "height": 700, "title": "Feed Reader" }
      }
    },
    {
      "name": "refresh feeds",
      "description": "Refresh all feeds",
      "action": { "type": "execute" }
    }
  ],
  "shortcuts": [
    {
      "keys": "Option+Shift+F",
      "command": "open feeds",
      "global": true
    }
  ]
}

{
  "manifestVersion": 3,
  "id": "todo",
  "shortname": "todo",
  "name": "Todo Commands",
  "description": "Quick `todo`, `todos` and `done` cmd-panel commands",
  "version": "1.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "todo:*",
        "cmd:execute:todo",
        "cmd:execute:todos",
        "cmd:execute:done",
        "cmd:register",
        "cmd:unregister",
        "ext:ready",
        "app:shutdown",
        "ext:todo:shutdown",
        "tag:item-added",
        "tag:item-removed",
        "item:created"
      ]
    },
    "datastore": {
      "tables": ["items", "tags", "item_tags"]
    },
    "commands": true
  },
  "commands": [
    {
      "name": "todo",
      "description": "Create a todo item (auto-tagged #todo). Inline #tags add extra tags.",
      "action": { "type": "execute" },
      "params": [
        { "name": "text", "type": "string", "required": true, "description": "What needs doing. Trailing #-prefixed words become extra tags." }
      ]
    },
    {
      "name": "todos",
      "description": "List the outstanding #todo items, newest first.",
      "action": { "type": "execute" }
    },
    {
      "name": "done",
      "description": "Mark a todo done. The list shows the outstanding #todo items; pick one, or type enough of its text to name it.",
      "action": { "type": "execute" },
      "params": [
        { "name": "match", "type": "item", "tag": "todo", "required": true, "description": "The outstanding todo to mark done. Typing filters by title or content (case-insensitive)." }
      ]
    }
  ]
}

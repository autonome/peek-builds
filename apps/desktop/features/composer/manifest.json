{
  "manifestVersion": 3,
  "id": "composer",
  "shortname": "composer",
  "name": "Composer",
  "description": "Quick item composer with tag management",
  "version": "1.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true,
      "lazyEvents": ["composer:open"]
    },
    {
      "id": "compose",
      "url": "compose.html",
      "role": "workspace",
      "key": "composer",
      "width": 600,
      "height": 500,
      "title": "Compose"
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global"],
      "topics": ["composer:*", "item:*", "ext:ready", "ext:composer:shutdown", "app:shutdown"]
    },
    "datastore": {
      "tables": ["items", "tags", "item_tags"]
    },
    "window": {
      "create": true
    },
    "commands": true,
    "shortcuts": true
  },
  "commands": [
    {
      "name": "compose",
      "description": "Create a new item",
      "action": { "type": "execute" }
    }
  ],
  "shortcuts": [
    {
      "keys": "CommandOrControl+Shift+N",
      "command": "compose"
    }
  ]
}

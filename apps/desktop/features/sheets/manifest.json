{
  "manifestVersion": 3,
  "id": "sheets",
  "shortname": "sheets",
  "name": "Sheets",
  "description": "Widget sheets with freeform card layouts hosting webviews",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true,
      "lazyEvents": [
        "sheets:open",
        "sheets:settings-changed"
      ]
    },
    {
      "id": "home",
      "url": "home.html",
      "role": "workspace",
      "width": 800,
      "height": 600,
      "title": "Sheets",
      "transparent": true,
      "seeThrough": true
    },
    {
      "id": "sheet",
      "url": "sheet.html",
      "title": "Sheet",
      "transparent": true,
      "seeThrough": true
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": [
        "global",
        "system"
      ],
      "topics": [
        "ext:ready",
        "cmd:register",
        "ext:sheets:shutdown",
        "app:shutdown",
        "sheets:open",
        "sheets:settings-changed",
        "sheets:deleted",
        "window:see-through"
      ]
    },
    "window": {
      "create": true
    },
    "commands": true,
    "dialogs": {
      "types": [
        "open"
      ]
    },
    "settings": true,
    "shortcuts": true,
    "webview": true
  },
  "commands": [
    {
      "name": "sheets",
      "description": "List all widget sheets",
      "action": {
        "type": "execute"
      }
    },
    {
      "name": "list sheets",
      "description": "List all widget sheets",
      "action": {
        "type": "execute"
      }
    },
    {
      "name": "open sheets",
      "description": "Browse all widget sheets as cards",
      "action": {
        "type": "window",
        "url": "peek://sheets/home.html",
        "options": {
          "width": 800,
          "height": 600,
          "role": "workspace",
          "transparent": true
        }
      }
    },
    {
      "name": "new sheet",
      "description": "Create a new widget sheet, optionally named",
      "action": {
        "type": "execute"
      }
    },
    {
      "name": "open sheet",
      "description": "Open an existing widget sheet by name",
      "action": {
        "type": "execute"
      }
    }
  ],
  "wakeShortcutsFromSettings": true
}

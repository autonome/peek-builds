{
  "manifestVersion": 3,
  "id": "sheets",
  "shortname": "sheets",
  "name": "Sheets",
  "description": "Widget sheets with freeform card layouts hosting webviews",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true,
      "lazyEvents": [
        "sheets:open",
        "sheets:settings-changed"
      ]
    },
    {
      "id": "sheet",
      "url": "sheet.html",
      "title": "Sheet",
      "transparent": true,
      "seeThrough": true
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": [
        "global",
        "system"
      ],
      "topics": [
        "ext:ready",
        "ext:sheets:shutdown",
        "app:shutdown",
        "sheets:open",
        "sheets:settings-changed",
        "window:see-through"
      ]
    },
    "window": {
      "create": true
    },
    "commands": true,
    "settings": true,
    "shortcuts": true,
    "webview": true
  },
  "commands": [
    {
      "name": "sheets",
      "description": "List all widget sheets",
      "action": {
        "type": "execute"
      }
    },
    {
      "name": "new sheet",
      "description": "Create a new widget sheet",
      "action": {
        "type": "execute"
      }
    },
    {
      "name": "open sheet",
      "description": "Open an existing widget sheet by name",
      "action": {
        "type": "execute"
      }
    }
  ],
  "wakeShortcutsFromSettings": true
}

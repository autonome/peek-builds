{
  "manifestVersion": 3,
  "id": "peeks",
  "shortname": "peeks",
  "name": "Peeks",
  "description": "Quick access modal windows for web pages via keyboard shortcuts",
  "version": "2.0.0",
  "builtin": true,
  "settingsSchema": "./settings-schema.json",
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true,
      "lazyEvents": ["cli:peek-open", "peeks:settings-changed"]
    }
  ],
  "shortcuts": [
    {
      "keys": "Option+0",
      "wakeTopic": "cli:peek-open",
      "wakeArgs": ["0"]
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "peeks:*",
        "ext:ready",
        "app:shutdown",
        "ext:peeks:shutdown",
        "cli:peek-open"
      ]
    },
    "window": {
      "create": true
    },
    "shortcuts": true,
    "settings": true
  }
}

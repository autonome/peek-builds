{
  "manifestVersion": 3,
  "id": "connectory",
  "shortname": "connectory",
  "name": "Connectory",
  "description": "Follows organizers' event feeds and saves new events as event:new items",
  "version": "1.0.0",
  "builtin": true,
  "settingsSchema": "./settings-schema.json",
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true,
      "schedule": [
        { "topic": "connectory:check", "everyMinutes": 60 }
      ]
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "app:shutdown",
        "connectory:check",
        "cmd:execute:search"
      ]
    },
    "datastore": {
      "tables": ["items", "tags", "item_tags"]
    },
    "network": {
      "domains": ["*", "http://localhost:*", "http://127.0.0.1:*"]
    },
    "settings": true,
    "commands": true
  },
  "commands": [
    {
      "name": "events",
      "description": "List events newly found in the feeds you follow",
      "action": { "type": "execute" }
    }
  ]
}

{
  "manifestVersion": 3,
  "id": "research",
  "shortname": "research",
  "name": "Research",
  "description": "Keep or drop a page, and the research's own view of its pages",
  "version": "1.1.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true
    },
    {
      "id": "home",
      "url": "home.html",
      "role": "workspace",
      "key": "research-view",
      "width": 900,
      "height": 700,
      "title": "Research",
      "transparent": true,
      "seeThrough": true
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "cmd:execute:*",
        "ext:ready",
        "ext:research:shutdown",
        "app:shutdown",
        "tag:item-added",
        "tag:item-removed",
        "tag:created",
        "tag:deleted",
        "tag:renamed",
        "item:created",
        "item:updated",
        "item:deleted",
        "item:restored",
        "sync:pull-completed",
        "rules:changed",
        "window:see-through"
      ]
    },
    "datastore": {
      "tables": ["items", "tags", "item_tags", "item_visits"]
    },
    "window": {
      "create": true,
      "query": true,
      "manage": true
    },
    "context": {
      "read": ["mode"]
    },
    "commands": true
  },
  "commands": [
    {
      "name": "keep",
      "description": "Keep the active page, with an optional one-line note",
      "action": { "type": "execute" }
    },
    {
      "name": "drop",
      "description": "Drop the active page, with an optional one-line note",
      "action": { "type": "execute" }
    },
    {
      "name": "unjudge",
      "description": "Clear the active page's kept or dropped state, keeping its note",
      "action": { "type": "execute" }
    },
    {
      "name": "research view",
      "description": "Show this research's pages, the ones that held attention longest first",
      "action": { "type": "execute" }
    }
  ]
}

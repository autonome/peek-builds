{
  "manifestVersion": 3,
  "id": "widget-demo",
  "shortname": "widget-demo",
  "name": "Widget Demo",
  "description": "Demonstration extension showcasing widget sheet capabilities",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "sheet",
      "url": "sheet.html",
      "key": "peek://widget-demo/sheet.html",
      "title": "Widget Demo"
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "app:shutdown",
        "ext:widget-demo:shutdown",
        "cmd:register",
        "cmd:execute:*"
      ]
    },
    "commands": true,
    "settings": true,
    "window": {
      "create": true
    },
    "webview": true
  },
  "commands": [
    {
      "name": "widget demo",
      "description": "Open the widget demo sheet",
      "action": { "type": "execute" }
    },
    {
      "name": "demo widgets",
      "description": "Open the widget demo sheet (alias)",
      "action": { "type": "execute" }
    }
  ]
}

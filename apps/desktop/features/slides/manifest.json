{
  "manifestVersion": 3,
  "id": "slides",
  "shortname": "slides",
  "name": "Slides",
  "description": "Edge-anchored slide-in panels triggered by keyboard shortcuts",
  "version": "2.0.0",
  "builtin": true,
  "settingsSchema": "./settings-schema.json",
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true,
      "lazyEvents": ["cli:slide-open", "slides:settings-changed"]
    }
  ],
  "shortcuts": [
    {
      "keys": "Option+Up",
      "wakeTopic": "cli:slide-open",
      "wakeArgs": ["Up"]
    }
  ],
  "wakeShortcutsFromSettings": true,
  "capabilities": {
    "pubsub": {
      "scopes": ["global"],
      "topics": [
        "slides:settings-changed",
        "slides:settings-update",
        "window:closed",
        "cli:slide-open"
      ]
    },
    "window": {
      "create": true,
      "manage": true
    },
    "shortcuts": true,
    "settings": true
  }
}

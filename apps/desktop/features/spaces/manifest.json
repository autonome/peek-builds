{
  "manifestVersion": 3,
  "id": "spaces",
  "shortname": "spaces",
  "name": "Spaces",
  "description": "Workspace mode with auto-tagging, screen border, and session management",
  "version": "2.0.0",
  "builtin": true,
  "tiles": [
    {
      "id": "background",
      "url": "background.html",
      "lazy": true,
      "lazyEvents": ["spaces:ensure-default"]
    },
    {
      "id": "home",
      "url": "home.html",
      "role": "workspace",
      "width": 800,
      "height": 600,
      "title": "Spaces"
    },
    {
      "id": "border",
      "url": "border.html",
      "role": "overlay",
      "transparent": true,
      "frame": false,
      "focusable": false,
      "alwaysOnTop": true
    },
    {
      "id": "panel",
      "url": "panel.html",
      "role": "overlay",
      "transparent": true,
      "frame": false,
      "skipTaskbar": true,
      "title": "Workspace"
    }
  ],
  "capabilities": {
    "pubsub": {
      "scopes": ["global", "system"],
      "topics": [
        "ext:ready",
        "ext:spaces:shutdown",
        "app:shutdown",
        "cmd:execute:*",
        "cmd:register",
        "cmd:unregister",
        "item:created",
        "item:deleted",
        "item:updated",
        "tag:item-added",
        "tag:item-removed",
        "tag:created",
        "tag:deleted",
        "tag:renamed",
        "tag:color-changed",
        "sync:pull-completed",
        "window:focused",
        "window:closed",
        "app:focus-changed",
        "context:changed",
        "spaces:*"
      ]
    },
    "datastore": {
      "tables": ["tags", "items", "item_tags"]
    },
    "context": {
      "read": ["mode", "pin"],
      "write": ["mode", "pin"],
      "modes": true,
      "queryWindows": true
    },
    "window": {
      "create": true,
      "query": true,
      "manage": true
    },
    "commands": true,
    "session": true
  },
  "commands": [
    {
      "name": "open space",
      "description": "Open a space (restore saved state or show home)",
      "action": { "type": "execute" }
    },
    {
      "name": "close space",
      "description": "Save window state, close the workspace, and return to the default workspace",
      "action": { "type": "execute" }
    },
    {
      "name": "switch space",
      "description": "Close current space and open another",
      "action": { "type": "execute" }
    },
    {
      "name": "open spaces",
      "description": "Browse all spaces",
      "action": {
        "type": "window",
        "url": "peek://spaces/home.html",
        "options": {
          "width": 800,
          "height": 600,
          "role": "workspace"
        }
      }
    },
    {
      "name": "pin to this workspace",
      "description": "Keep the active window visible only while this workspace is active",
      "action": { "type": "execute" }
    },
    {
      "name": "pin across workspaces",
      "description": "Keep the active window visible in every workspace",
      "action": { "type": "execute" }
    },
    {
      "name": "unpin window",
      "description": "Stop pinning the active window",
      "action": { "type": "execute" }
    }
  ]
}
